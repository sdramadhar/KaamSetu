generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum RoleType {
  WORKER
  STUDENT
  EMPLOYER
  CONTRACTOR
  TRAINING_PROVIDER
  PARTNER
  FIELD_COORDINATOR
  ADMIN
}

enum OpportunityType {
  DAILY_WAGE
  PART_TIME
  FULL_TIME
  CONTRACT
  APPRENTICESHIP
  VOLUNTEER
}

enum OpportunityStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum WorkStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  PENDING
}

enum ConsentType {
  PROFILE_DISCOVERY
  CONTACT_SHARING
  LOCATION_APPROXIMATION
  DATA_PROCESSING
  COMMUNICATIONS
}

enum CertificationStatus {
  PENDING
  VERIFIED
  EXPIRED
  REJECTED
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  WITHDRAWN
}

enum PaymentStatus {
  RECORDED
  PENDING
  DISPUTED
  VOIDED
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum FraudEventStatus {
  OPEN
  REVIEWING
  CLEARED
  CONFIRMED
}

enum RecommendationFeedbackType {
  RELEVANT
  NOT_RELEVANT
  HIDDEN
  APPLIED
}

model User {
  id                       String                   @id @default(uuid()) @db.Uuid
  phone                    String?                  @unique
  email                    String?                  @unique
  status                   UserStatus               @default(ACTIVE)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  deletedAt                DateTime?
  profile                  Profile?
  workerProfile            WorkerProfile?
  employerProfiles         EmployerProfile[]
  roles                    UserRole[]
  skills                   UserSkill[]
  certifications           Certification[]
  applications             Application[]
  enrollments              Enrollment[]
  notifications            Notification[]
  ratingsGiven             Rating[]                 @relation("RatingAuthor")
  ratingsReceived          Rating[]                 @relation("RatingSubject")
  verificationRequests     VerificationRequest[]    @relation("VerificationSubject")
  verificationReviews      VerificationRequest[]    @relation("VerificationReviewer")
  reportsFiled             Report[]                 @relation("ReportReporter")
  reportsAgainst           Report[]                 @relation("ReportSubject")
  consents                 Consent[]
  auditEvents              AuditLog[]               @relation("AuditActor")
  workAgreementsAsWorker   WorkAgreement[]          @relation("AgreementWorker")
  workAgreementsAsEmployer WorkAgreement[]          @relation("AgreementEmployer")
  recommendations          Recommendation[]
  recommendationFeedback   RecommendationFeedback[]
  productEvents            ProductEvent[]
  disputesRaised           Dispute[]                @relation("DisputeRaisedBy")
  disputesAgainst          Dispute[]                @relation("DisputeAgainst")
  fraudEvents              FraudEvent[]             @relation("FraudSubject")
  fraudEventsReported      FraudEvent[]             @relation("FraudReporter")

  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id        String     @id @default(uuid()) @db.Uuid
  type      RoleType   @unique
  createdAt DateTime   @default(now())
  users     UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Profile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  displayName     String?
  preferredLocale String    @default("en-IN")
  localityId      String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  locality        Locality? @relation(fields: [localityId], references: [id], onDelete: SetNull)

  @@index([localityId])
  @@map("profiles")
}

model WorkerProfile {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @unique @db.Uuid
  headline            String?
  bio                 String?
  experienceYears     Int?
  availabilityNote    String?
  approximateRadiusKm Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  certifications      Certification[]
  applications        Application[]
  workAssignments     WorkAssignment[]

  @@index([deletedAt])
  @@map("worker_profiles")
}

model Certification {
  id              String              @id @default(uuid()) @db.Uuid
  workerProfileId String?             @db.Uuid
  userId          String              @db.Uuid
  name            String
  issuer          String?
  issuedAt        DateTime?
  expiresAt       DateTime?
  status          CertificationStatus @default(PENDING)
  documentRef     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workerProfile   WorkerProfile?      @relation(fields: [workerProfileId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([workerProfileId])
  @@map("certifications")
}

model Locality {
  id                   String         @id @default(uuid()) @db.Uuid
  name                 String
  region               String
  country              String         @default("IN")
  approximateLatitude  Decimal?       @db.Decimal(8, 5)
  approximateLongitude Decimal?       @db.Decimal(8, 5)
  createdAt            DateTime       @default(now())
  profiles             Profile[]
  organizations        Organization[]
  opportunities        Opportunity[]

  @@unique([name, region, country])
  @@index([region, name])
  @@map("localities")
}

model Skill {
  id            String             @id @default(uuid()) @db.Uuid
  name          String
  slug          String             @unique
  createdAt     DateTime           @default(now())
  userSkills    UserSkill[]
  opportunities OpportunitySkill[]

  @@index([name])
  @@map("skills")
}

model UserSkill {
  userId      String    @db.Uuid
  skillId     String    @db.Uuid
  proficiency Int       @default(1)
  verifiedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId, proficiency])
  @@map("user_skills")
}

model Organization {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  localityId        String?            @db.Uuid
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  locality          Locality?          @relation(fields: [localityId], references: [id], onDelete: SetNull)
  employerProfiles  EmployerProfile[]
  opportunities     Opportunity[]
  trainingProviders TrainingProvider[]

  @@index([name])
  @@index([localityId])
  @@index([deletedAt])
  @@map("organizations")
}

model EmployerProfile {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  organizationId String?       @db.Uuid
  title          String?
  verifiedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  opportunities  Opportunity[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("employer_profiles")
}

model Opportunity {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String?            @db.Uuid
  employerProfileId String?            @db.Uuid
  localityId        String?            @db.Uuid
  title             String
  description       String?
  type              OpportunityType
  status            OpportunityStatus  @default(DRAFT)
  payAmount         Decimal?           @db.Decimal(12, 2)
  payCurrency       String             @default("INR")
  worksiteNote      String?
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  employerProfile   EmployerProfile?   @relation(fields: [employerProfileId], references: [id], onDelete: SetNull)
  locality          Locality?          @relation(fields: [localityId], references: [id], onDelete: SetNull)
  skills            OpportunitySkill[]
  applications      Application[]
  recommendations   Recommendation[]
  agreements        WorkAgreement[]

  @@index([status, type, localityId])
  @@index([organizationId, createdAt])
  @@index([employerProfileId])
  @@index([startsAt])
  @@index([deletedAt])
  @@map("opportunities")
}

model OpportunitySkill {
  opportunityId String      @db.Uuid
  skillId       String      @db.Uuid
  required      Boolean     @default(true)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skill         Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([opportunityId, skillId])
  @@index([skillId])
  @@map("opportunity_skills")
}

model Application {
  id              String            @id @default(uuid()) @db.Uuid
  opportunityId   String            @db.Uuid
  applicantId     String            @db.Uuid
  workerProfileId String?           @db.Uuid
  status          ApplicationStatus @default(SUBMITTED)
  note            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  opportunity     Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicant       User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  workerProfile   WorkerProfile?    @relation(fields: [workerProfileId], references: [id], onDelete: SetNull)
  agreements      WorkAgreement[]

  @@unique([opportunityId, applicantId])
  @@index([applicantId, status])
  @@index([opportunityId, status, createdAt])
  @@map("applications")
}

model VerificationRequest {
  id         String             @id @default(uuid()) @db.Uuid
  subjectId  String             @db.Uuid
  reviewerId String?            @db.Uuid
  type       String
  status     VerificationStatus @default(PENDING)
  notes      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  reviewedAt DateTime?
  subject    User               @relation("VerificationSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  reviewer   User?              @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([subjectId, status])
  @@index([reviewerId, status])
  @@map("verification_requests")
}

model Rating {
  id        String   @id @default(uuid()) @db.Uuid
  authorId  String   @db.Uuid
  subjectId String   @db.Uuid
  score     Int
  comment   String?
  createdAt DateTime @default(now())
  author    User     @relation("RatingAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject   User     @relation("RatingSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([authorId, subjectId])
  @@index([subjectId, createdAt])
  @@map("ratings")
}

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  reporterId String       @db.Uuid
  subjectId  String?      @db.Uuid
  entityType String
  entityId   String?
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  reporter   User         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  subject    User?        @relation("ReportSubject", fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([subjectId])
  @@index([entityType, entityId])
  @@map("reports")
}

model TrainingProvider {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  name           String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  courses        Course[]

  @@index([organizationId])
  @@map("training_providers")
}

model Course {
  id                 String           @id @default(uuid()) @db.Uuid
  trainingProviderId String           @db.Uuid
  title              String
  description        String?
  durationHours      Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  trainingProvider   TrainingProvider @relation(fields: [trainingProviderId], references: [id], onDelete: Cascade)
  enrollments        Enrollment[]

  @@index([trainingProviderId, createdAt])
  @@map("courses")
}

model Enrollment {
  id          String           @id @default(uuid()) @db.Uuid
  courseId    String           @db.Uuid
  userId      String           @db.Uuid
  status      EnrollmentStatus @default(ENROLLED)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId, status])
  @@map("enrollments")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model WorkAgreement {
  id            String           @id @default(uuid()) @db.Uuid
  opportunityId String?          @db.Uuid
  applicationId String?          @db.Uuid
  workerId      String           @db.Uuid
  employerId    String           @db.Uuid
  status        WorkStatus       @default(PLANNED)
  termsVersion  String
  agreedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  opportunity   Opportunity?     @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  application   Application?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  worker        User             @relation("AgreementWorker", fields: [workerId], references: [id], onDelete: Cascade)
  employer      User             @relation("AgreementEmployer", fields: [employerId], references: [id], onDelete: Cascade)
  assignments   WorkAssignment[]
  ledgerEntries WageLedger[]
  payments      PaymentRecord[]
  disputes      Dispute[]

  @@index([workerId, status])
  @@index([employerId, status])
  @@index([opportunityId])
  @@map("work_agreements")
}

model WorkAssignment {
  id              String         @id @default(uuid()) @db.Uuid
  agreementId     String         @db.Uuid
  workerProfileId String?        @db.Uuid
  status          WorkStatus     @default(PLANNED)
  localityId      String?        @db.Uuid
  safeMeetingNote String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  agreement       WorkAgreement  @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  workerProfile   WorkerProfile? @relation(fields: [workerProfileId], references: [id], onDelete: SetNull)
  shifts          WorkShift[]

  @@index([agreementId, status])
  @@index([workerProfileId])
  @@map("work_assignments")
}

model WorkShift {
  id           String         @id @default(uuid()) @db.Uuid
  assignmentId String         @db.Uuid
  startsAt     DateTime
  endsAt       DateTime?
  status       WorkStatus     @default(PLANNED)
  createdAt    DateTime       @default(now())
  assignment   WorkAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  attendance   Attendance?

  @@index([assignmentId, startsAt])
  @@index([startsAt, status])
  @@map("work_shifts")
}

model Attendance {
  id         String           @id @default(uuid()) @db.Uuid
  shiftId    String           @unique @db.Uuid
  status     AttendanceStatus @default(PENDING)
  note       String?
  recordedAt DateTime?
  createdAt  DateTime         @default(now())
  shift      WorkShift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([status, recordedAt])
  @@map("attendance")
}

model WageLedger {
  id          String        @id @default(uuid()) @db.Uuid
  agreementId String        @db.Uuid
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("INR")
  periodStart DateTime?
  periodEnd   DateTime?
  note        String?
  createdAt   DateTime      @default(now())
  agreement   WorkAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([agreementId, createdAt])
  @@map("wage_ledger")
}

model PaymentRecord {
  id          String        @id @default(uuid()) @db.Uuid
  agreementId String        @db.Uuid
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("INR")
  status      PaymentStatus @default(RECORDED)
  reference   String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  agreement   WorkAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([agreementId, status, createdAt])
  @@index([reference])
  @@map("payment_records")
}

model Dispute {
  id          String         @id @default(uuid()) @db.Uuid
  agreementId String?        @db.Uuid
  raisedById  String         @db.Uuid
  againstId   String?        @db.Uuid
  reason      String
  status      DisputeStatus  @default(OPEN)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  agreement   WorkAgreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  raisedBy    User           @relation("DisputeRaisedBy", fields: [raisedById], references: [id], onDelete: Cascade)
  against     User?          @relation("DisputeAgainst", fields: [againstId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([raisedById])
  @@map("disputes")
}

model FraudEvent {
  id         String           @id @default(uuid()) @db.Uuid
  subjectId  String?          @db.Uuid
  reportedBy String?          @db.Uuid
  eventType  String
  status     FraudEventStatus @default(OPEN)
  details    Json?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  subject    User?            @relation("FraudSubject", fields: [subjectId], references: [id], onDelete: SetNull)
  reporter   User?            @relation("FraudReporter", fields: [reportedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([subjectId])
  @@map("fraud_events")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  requestId  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

model Consent {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  type        ConsentType
  granted     Boolean     @default(false)
  version     String
  createdAt   DateTime    @default(now())
  withdrawnAt DateTime?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@map("consents")
}

model Recommendation {
  id            String                   @id @default(uuid()) @db.Uuid
  userId        String                   @db.Uuid
  opportunityId String                   @db.Uuid
  reason        String?
  score         Decimal?                 @db.Decimal(5, 4)
  createdAt     DateTime                 @default(now())
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity   Opportunity              @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  feedback      RecommendationFeedback[]

  @@unique([userId, opportunityId])
  @@index([userId, createdAt])
  @@index([opportunityId])
  @@map("recommendations")
}

model RecommendationFeedback {
  id               String                     @id @default(uuid()) @db.Uuid
  recommendationId String                     @db.Uuid
  userId           String                     @db.Uuid
  type             RecommendationFeedbackType
  note             String?
  createdAt        DateTime                   @default(now())
  recommendation   Recommendation             @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([recommendationId])
  @@map("recommendation_feedback")
}

model ProductEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  eventName  String
  properties Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventName, createdAt])
  @@index([userId, createdAt])
  @@map("product_events")
}
